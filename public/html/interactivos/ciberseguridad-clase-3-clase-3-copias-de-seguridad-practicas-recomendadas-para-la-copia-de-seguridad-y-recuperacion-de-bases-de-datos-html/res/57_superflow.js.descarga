    }

    .s-presence-avatar-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .s-presence-avatar-image-small {
        width: ${hc(1.6)};
        height: auto;
        display: block;
    }

    .s-presence-avatar-initial {
        color: white;
    }

    .away {
        filter: grayscale(1);
    }

