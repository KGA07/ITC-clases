    .s-primary:hover {
        background: #4f4bbf;
    }

    .s-modal-text {
        gap: ${hc(.2)};
        max-width: ${hc(30)};
        text-align: center;
        padding-left: 0px;
        padding-right: 0px;
        width: 100%;
    }

    @media only screen and (max-width: 620px) {

        .snippyly-plugin-container {
            left: 50%;
            right: unset !important;
            transform: translate(-50%, 0);
            margin-left: 0;
            margin-right: 0;
        }
        .snippyly-plugin-container .d-sm-none {
            display: none;
        }
        .profile-img {
            margin-left: 8px;
        }

        .comment-tool-container .tour-tooltiptext {
            left: 0 !important;
        }

        .comment-tool-container .tour-tooltiptext::after {
            right: calc(100% - 16px) !important;
        }
    }

    @media only screen and (max-width: 400px) {
        .snippyly-plugin-container .d-xs-none {
            display: none;
        }

        .action-text {
            margin-right: 0 !important;
        }

        .snippyly-plugin-container svg {
            max-width: 28px !important;
            max-height: 28px !important;
        }

        .action-dropdown {
            padding: 0px 2px;
        }
