    .s-alert-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        border-radius: 16px;
        background: #FFF8E1;
    }

    .s-alert-btn .error-container {
        display: flex;
        gap: 4px;
        align-items: center;
        color: #EDB400;
        padding: 4px 8px;
