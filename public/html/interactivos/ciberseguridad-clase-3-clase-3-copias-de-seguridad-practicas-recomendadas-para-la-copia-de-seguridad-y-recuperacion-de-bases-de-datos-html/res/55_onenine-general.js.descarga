console.log('Debug: onenine-general.js loaded');

// Update the initialization code
function initializeColorPicker() {
    console.log('Debug: Initializing color picker');
    
    const body = document.querySelector("body");
    const colorModal = document.getElementById('colorModal');
    const colorPickerButton = document.getElementById('colorPicker');
    const modes = ["blue", "purple", "orange", "green", "random", "bw"];

    // Get stored mode or default to random
    let getMode = localStorage.getItem("mode") || 'random';
    
    // Validate the stored mode
    if (modes.includes(getMode)) {
        // Remove any existing mode classes first
        modes.forEach(mode => body.classList.remove(mode));
        
        // Add the stored mode class
        body.classList.add(getMode);
        
        // Update the radio button
        const selectedInput = document.getElementById(getMode);
        if (selectedInput) {
            selectedInput.checked = true;
            // Update the label
            document.querySelectorAll("#color-toggle label").forEach((label) => {
                label.classList.remove("checked");
            });
            document.querySelector(`label[for='${getMode}']`).classList.add("checked");
        }
        
        // Update visual elements
        updateAllGradients(getMode);
        updateColorPickerButton(getMode);
    }

    // Use event delegation for color changes
    document.body.addEventListener('change', function(event) {
        if (event.target && event.target.matches("#color-toggle input[name='color']")) {
            handleColorChange(event.target.value);
        }
    });
}

// Update the handleColorChange function to properly handle the bw class
function handleColorChange(selectedMode) {
    console.log("Selected mode: ", selectedMode);
    const body = document.querySelector("body");
    const modes = ["blue", "purple", "orange", "green", "random", "bw"];

    // Remove all color classes
    body.classList.remove(...modes);
    console.log("Removed classes: ", body.classList);

    // Add the new color class
    body.classList.add(selectedMode);
    console.log("Added class: ", selectedMode);

    // Special handling for bw mode
    if (selectedMode === 'bw') {
        // Ensure the bw-specific styles are applied
        document.querySelectorAll('.blog-archive-feed .row .col-4 a.card .blog-card-icon').forEach(icon => {
            icon.style.backgroundImage = "url('../../assets/img/asterisk-color-bw.svg')";
        });
    }

    // Remove "checked" class from all labels
    document.querySelectorAll("#color-toggle label").forEach((label) => {
        label.classList.remove("checked");
    });

    // Add "checked" class to the selected label
    const selectedLabel = document.querySelector(`label[for='${selectedMode}']`);
    if (selectedLabel) {
        selectedLabel.classList.add("checked");
    }

    // Store the selected mode in localStorage
    localStorage.setItem("mode", selectedMode);
    console.log("Stored mode in localStorage: ", localStorage.getItem("mode"));

    // Update all gradients
    updateAllGradients(selectedMode);
    updateColorPickerButton(selectedMode);

    // Close the modal
    const colorModal = document.getElementById('colorModal');
    const modalInstance = bootstrap.Modal.getInstance(colorModal);
    if (modalInstance) {
        modalInstance.hide();
    }
}
function getGradient(color) {
    switch(color) {
        case 'blue':
            return 'linear-gradient(121deg, #AAF5FF 0.16%, #5FA9FF 50.16%, #0047FF 100.16%)';
        case 'purple':
            return 'linear-gradient(121deg, #D797FF 0.16%, #C0F 50.16%, #9500CA 100.16%)';
        case 'orange':
            return 'linear-gradient(121deg, #FF8956 0.16%, #FF4C00 50.16%, #FF7A00 100.16%)';
        case 'green':
            return 'linear-gradient(121deg, #1D976C 0.16%, #93F9B9 100.16%)';
        case 'bw':
            return 'linear-gradient(140deg, #000 0%, #333 50%, #666 100%)';
        default: // random
            return 'linear-gradient(75deg, #665BEA 9.47%, #AD27DC 45.29%, #E7854E 98.01%)';
    }
}

function getCircleColors(color) {
    switch(color) {
        case 'blue': return ['#00E0FF', '#301EFF', '#AD00FF'];
        case 'purple': return ['#6100FF', '#B200F0', '#FF00A8'];
        case 'orange': return ['#FF0099', '#FF5C00', '#FFA800'];
        case 'green': return ['#EBFF00', '#00D121', '#00FFF0'];
        case 'bw': return ['#000000', '#333333', '#666666'];
        default: // random
            return ['#665BEA', '#AD27DC', '#E7854E'];
    }
}

function updateAllGradients(color) {
    console.log('Updating all gradients with color:', color);
    updateTextGradients(color);
    updateBackgroundCircles(color);
    updateOtherGradients(color);
}

function updateTextGradients(color) {
    const gradient = getGradient(color);
    const gradientElements = document.querySelectorAll('.gradient-text');
    gradientElements.forEach(element => {
        element.style.backgroundImage = gradient;
    });
    console.log('Updated', gradientElements.length, 'text gradient elements');
}

function updateBackgroundCircles(color) {
    const colors = getCircleColors(color);
    const circles = ['.circle-primary', '.circle-secondary', '.circle-tertiary'];
    circles.forEach((circleClass, index) => {
        const circle = document.querySelector(circleClass);
        if (circle) {
            circle.style.backgroundColor = colors[index];
        }
    });
    console.log('Updated background circles');
}

function updateOtherGradients(color) {
    const gradient = getGradient(color);
    const planSelector = document.getElementById("plan-type-selector");
    const portfolioDetailSection = document.querySelector('.portfolio-detail-single');
    
    if (planSelector) {
        planSelector.style.background = gradient;
    }
    
    if (portfolioDetailSection) {
        const portfolioGradient = `linear-gradient(135deg, #ffffff 0%, ${color === 'bw' ? 'rgba(102,102,102,0.2)' : 'rgba(102,91,234,0.2)'} 100%)`;
        portfolioDetailSection.style.background = portfolioGradient;
    }
    
    const otherGradientElements = document.querySelectorAll('.onenine-bg-gradient');
    otherGradientElements.forEach(element => {
        element.style.background = gradient;
    });
    console.log('Updated other gradient elements');
}

function updateColorPickerButton(color) {
    const colorPickerButton = document.getElementById('colorPicker');
    if (colorPickerButton) {
        const gradient = getGradient(color);
        colorPickerButton.style.background = gradient;
        console.log('Updated color picker button gradient:', gradient);
    } else {
        console.error('Color picker button not found');
    }
}

// Initialize color picker when DOM is fully loaded
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeColorPicker);
} else {
    initializeColorPicker();
}

