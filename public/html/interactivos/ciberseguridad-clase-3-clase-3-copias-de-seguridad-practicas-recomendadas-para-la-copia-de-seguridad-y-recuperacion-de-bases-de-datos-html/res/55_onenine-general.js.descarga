/* WEBSITE DESIGN - PORTFOLIO */
  jQuery(document).ready(function ($) {
  let scrollPosition;

  function adjustLayout() {
    $(".portfolio_main_flex").css("width", "100%");
    $(".portfolio_main_listing_listing, .portfolio-detail-single").css("width", "100%");
  }

  $(window).on("load", function () {
    $(".site-loader").addClass("hide");
    $("body").removeClass("site-loader-active");
    adjustLayout();
  });

  /* WEBSITE DESIGN - PORTFOLIO */
jQuery(document).ready(function ($) {
  let scrollPosition;

  function adjustLayout() {
    $(".portfolio_main_flex").css("width", "100%");
    $(".portfolio_main_listing_listing, .portfolio-detail-single").css("width", "100%");
  }

  $(window).on("load", function () {
    $(".site-loader").addClass("hide");
    $("body").removeClass("site-loader-active");
    adjustLayout();
  });

  function loadPortfolioContent(postId) {
    $.ajax({
        url: `/wp-json/wp/v2/portfolio/${postId}`,
        type: "GET",
        beforeSend: function () {
            console.log("Sending REST API request...");
            $(".site_loader").addClass("active");
        },
    })
    .done(function (res) {
        console.log(res);

        var newSiteLayoutUrl = "";
        var newMobileLayoutUrl = "";

        var fetchImageUrls = [
            $.ajax({
                url: `/wp-json/wp/v2/media/${res.acf.new_site_layout}`,
                type: "GET",
                success: function (mediaRes) {
                    newSiteLayoutUrl = mediaRes.source_url;
                },
            }),
            $.ajax({
                url: `/wp-json/wp/v2/media/${res.acf.new_mobile_layout}`,
                type: "GET",
                success: function (mediaRes) {
                    newMobileLayoutUrl = mediaRes.source_url;
                },
            }),
        ];

        $.when(...fetchImageUrls).then(function () {
            const isSpanish = window.location.href.includes('/es/');
            // Use Spanish or English description based on URL
            const description = isSpanish ? (res.acf.portfolio_description_spanish || res.acf.portfolio_description) : res.acf.portfolio_description || '';
            
            var postContent = `
            <div class="portfolio-detail-single-content">
                <article id="post-${res.id}" class="single-portfolio">
                    <header class="entry-header">
                        <h1 class="entry-title">${res.title.rendered}</h1>
                        <div class="portfolio-description">${description}</div>
                    </header>
                    <div class="entry-content">
                        <div class="web_port_big_preview">
                            <img src="${newSiteLayoutUrl}" title="" alt="">
                        </div>
                        <div class="web_port_small_preview">
                            <img src="${newMobileLayoutUrl}" title="" alt="">
                        </div>
                        <div class="launch_live_site">
                            <a href="${res.acf.live_site_link}" target="_blank" class="btn btn-animated py-2 px-4 fs-6 text-uppercase text-white bg-black rounded-0">
                                <span>${isSpanish ? 'Ver sitio web en vivo' : 'View Live Website'}</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>`;

            $("#portfolio-detail-single-wrapper").html(postContent);

            setTimeout(function() {
                $('#hero-gradient').addClass('hidden');
                $('.portfolio_main_listing_listing').addClass('hidden');
                scrollPosition = window.pageYOffset;
                $('body').addClass('active-portfolio');
				// console.log("Added class: active-portfolio", $('body').attr('class'));
				
                $('html, body').animate({
                    scrollTop: $(".portfolio-detail-single").offset().top
                }, 10);
            }, 10);

            document.title = res.title.rendered;
            var url = res.link;
            window.history.pushState({ postId: postId }, null, url);

            $(".site_loader").removeClass("active");
        });
    })
    .fail(function (err) {
        console.log("REST API error:", err);
        $(".site_loader").removeClass("active");
    });
}

// Maintain the existing click handlers
$(".portfolio-wrapper .portfolio-item").click(function () {
    var postId = $(this).closest(".portfolio-item").data("id");
    console.log("Post ID:", postId);
    
    loadPortfolioContent(postId);
});

$(document).on("click", "#back-to-projects", function (e) {
    e.preventDefault();
    
    $('body').removeClass('active-portfolio').addClass('transitioning-out');
    
    setTimeout(function() {
        $('#hero-gradient').removeClass('hidden');
        $('.portfolio_main_listing_listing').removeClass('hidden');
        
        window.history.pushState({}, null, "/website-design/");

        window.scrollTo(0, scrollPosition);

        $('html, body').animate({
            scrollTop: $("#portfolio").offset().top
        }, 300);

        setTimeout(function() {
            $('body').removeClass('transitioning-out');
        }, 300);
    }, 300);
});

window.addEventListener("popstate", function (event) {
    if (event.state && event.state.postId) {
        loadPortfolioContent(event.state.postId);
    } else {
        $('body').removeClass('active-portfolio').addClass('transitioning-out');
        
        setTimeout(function() {
            $('#hero-gradient').removeClass('hidden');
            $('.portfolio_main_listing_listing').removeClass('hidden');

            window.scrollTo(0, scrollPosition);

            setTimeout(function() {
                $('body').removeClass('transitioning-out');
            }, 300);
        }, 300);
    }
});

  function resetMobileMenu() {
    const navToggler = $(".nav-toggler");
    const flyoutMenu = $(".flyout_menu");
    const body = $("body");

    navToggler.removeClass("opened").addClass("not-opened");
    flyoutMenu.removeClass("dragged_in active_menu");
    body.removeClass("flyout_opened");

    initializeMobileMenu();
  }

  function initializeMobileMenu() {
    const navToggler = $(".nav-toggler");
    const offcanvasNavbar = $("#offcanvas-navbar");
    const flyoutMenu = $(".flyout_menu");
    const body = $("body");

    navToggler.off("click").on("click", function() {
      if ($(this).hasClass("not-opened")) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    function openMenu() {
      navToggler.removeClass("not-opened").addClass("opened");
      flyoutMenu.addClass("dragged_in active_menu");
      body.addClass("flyout_opened");
    }

    function closeMenu() {
      navToggler.removeClass("opened").addClass("not-opened");
      flyoutMenu.removeClass("dragged_in");
      setTimeout(function() {
        flyoutMenu.removeClass("active_menu");
      }, 350);
      setTimeout(function() {
        body.removeClass("flyout_opened");
      }, 500);
    }

    offcanvasNavbar.off("hidden.bs.offcanvas").on("hidden.bs.offcanvas", function() {
      closeMenu();
    });
  }

  initializeMobileMenu();

  // Mouse Follower
  function initializeCustomCursor() {
    if (window.innerWidth > 1024) {
      $(".portfolio-item, #portfolio-swiper .swiper-slide").mouseenter(function () {
        $(".follower").addClass("hide_it");
      }).mouseleave(function () {
        $(".follower").removeClass("hide_it");
      });

      $(".portfolio-wrapper .portfolio_main_flex .portfolio_main_listing_listing .portfolio-item, #portfolio-swiper .swiper-slide")
        .mouseenter(function () {
          if ($(".follower").hasClass("hide_it")) {
            $(".follower").removeClass("hide_it");
          }
          $(".follower").addClass("view_project");
        })
        .mouseleave(function () {
          $(".follower").removeClass("view_project");
        });

      mouseX = window.innerWidth / 2;
      mouseY = window.innerHeight / 2;

      circle = {
        el: $(".follower,.back_port_arrow"),
        x: window.innerWidth / 2,
        y: window.innerHeight / 2,
        w: 80,
        h: 80,
        update: function () {
          var l = this.x - this.w / 1.3;
          var t = this.y - this.h / 1.3;
          this.el.css({
            transform: "translate3d(" + l + "px," + t + "px, 0)"
          });
        }
      };

      $(window).mousemove(function (e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });
      
      function move() {
        circle.x = lerp(circle.x, mouseX, 0.1);
        circle.y = lerp(circle.y, mouseY, 0.1);
        circle.update();
      }

      function lerp(start, end, amt) {
        return (1 - amt) * start + amt * end;
      }

      setInterval(move, 1000 / 60);
    } else {
      $(".follower,.back_port_arrow").remove();
    }
  }

  initializeCustomCursor();

  $(window).resize(function() {
    initializeCustomCursor();
  });

  var initialSlug = window.location.pathname.split("/").filter(Boolean).pop();
  if (initialSlug && initialSlug !== "website-design") {
    $.get(`/wp-json/wp/v2/portfolio?slug=${initialSlug}`, function (data) {
      if (data.length) {
        loadPortfolioContent(data[0].id);
      }
    });
  }
});

  function resetMobileMenu() {
    const navToggler = $(".nav-toggler");
    const flyoutMenu = $(".flyout_menu");
    const body = $("body");

    navToggler.removeClass("opened").addClass("not-opened");
    flyoutMenu.removeClass("dragged_in active_menu");
    body.removeClass("flyout_opened");

    initializeMobileMenu();
  }

  function initializeMobileMenu() {
    const navToggler = $(".nav-toggler");
    const offcanvasNavbar = $("#offcanvas-navbar");
    const flyoutMenu = $(".flyout_menu");
    const body = $("body");

    navToggler.off("click").on("click", function() {
      if ($(this).hasClass("not-opened")) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    function openMenu() {
      navToggler.removeClass("not-opened").addClass("opened");
      flyoutMenu.addClass("dragged_in active_menu");
      body.addClass("flyout_opened");
    }

    function closeMenu() {
      navToggler.removeClass("opened").addClass("not-opened");
      flyoutMenu.removeClass("dragged_in");
      setTimeout(function() {
        flyoutMenu.removeClass("active_menu");
      }, 350);
      setTimeout(function() {
        body.removeClass("flyout_opened");
      }, 500);
    }

    offcanvasNavbar.off("hidden.bs.offcanvas").on("hidden.bs.offcanvas", function() {
      closeMenu();
    });
  }

  initializeMobileMenu();

  // Mouse Follower
function initializeCustomCursor() {
    if (window.innerWidth > 1024) { // Typically, 1024px and above is considered desktop
      $(".portfolio-item").mouseenter(function () {
        $(".follower").addClass("hide_it");
      }).mouseleave(function () {
        $(".follower").removeClass("hide_it");
      });

      $(".portfolio-wrapper .portfolio_main_flex .portfolio_main_listing_listing .portfolio-item")
        .mouseenter(function () {
          if ($(".follower").hasClass("hide_it")) {
            $(".follower").removeClass("hide_it");
          }
          $(".follower").addClass("view_project");
        })
        .mouseleave(function () {
          $(".follower").removeClass("view_project");
        });

      mouseX = window.innerWidth / 2;
      mouseY = window.innerHeight / 2;

      circle = {
        el: $(".follower,.back_port_arrow"),
        x: window.innerWidth / 2,
        y: window.innerHeight / 2,
        w: 80,
        h: 80,
        update: function () {
          var l = this.x - this.w / 1.3;
          var t = this.y - this.h / 1.3;
          this.el.css({
            transform: "translate3d(" + l + "px," + t + "px, 0)"
          });
        }
      };

      $(window).mousemove(function (e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });
      
      function move() {
        circle.x = lerp(circle.x, mouseX, 0.1);
        circle.y = lerp(circle.y, mouseY, 0.1);
        circle.update();
      }

      function lerp(start, end, amt) {
        return (1 - amt) * start + amt * end;
      }

      // Start the animation loop only for desktop
      setInterval(move, 1000 / 60);
    } else {
      // Remove custom cursor elements and clear interval for non-desktop devices
      $(".follower,.back_port_arrow").remove();
    }
  }

  // Initialize custom cursor
  initializeCustomCursor();

  // Reinitialize custom cursor on window resize
  $(window).resize(function() {
    initializeCustomCursor();
  });

  var initialSlug = window.location.pathname.split("/").filter(Boolean).pop();
  if (initialSlug && initialSlug !== "website-design") {
    
    $.get(`/wp-json/wp/v2/portfolio?slug=${initialSlug}`, function (data) {
      if (data.length) {
        loadPortfolioContent(data[0].id);
      }
    });
  }
});