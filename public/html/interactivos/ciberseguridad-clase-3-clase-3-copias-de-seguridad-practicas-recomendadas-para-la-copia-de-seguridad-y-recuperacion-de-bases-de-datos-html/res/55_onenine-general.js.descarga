/* Initiate AOS */
document.addEventListener("DOMContentLoaded", function () {

  // Initial AOS setup
  AOS.init({
    once: false,
    useClassNames: true,
    initClassName: false,
    animatedClassName: "animated",
  });

});






document.addEventListener("DOMContentLoaded", function () {
  const body = document.querySelector("body");
  const toggles = document.querySelectorAll("#color-toggle input[name='color']");
  const planSelector = document.getElementById("plan-type-selector");
  const portfolioDetailSection = document.querySelector('.portfolio-detail-single');
  const modes = ["blue", "purple", "orange", "green", "random", "bw"];

  let getMode = localStorage.getItem("mode");
  if (getMode && modes.includes(getMode)) {
    body.classList.add(getMode);
    document.getElementById(getMode).checked = true;
    document.querySelector(`label[for='${getMode}']`).classList.add("checked");
    updateGradients(getMode);
  }

  toggles.forEach((toggle) => {
    toggle.addEventListener("change", (event) => {
      const selectedMode = event.target.value;
      console.log("Selected mode: ", selectedMode);

      // Remove all color classes
      body.classList.remove(...modes);
      console.log("Removed classes: ", body.classList);

      // Add the new color class
      body.classList.add(selectedMode);
      console.log("Added class: ", selectedMode);

      // Remove "checked" class from all labels
      document.querySelectorAll("#color-toggle label").forEach((label) => {
        label.classList.remove("checked");
      });

      // Add "checked" class to the selected label
      document
        .querySelector(`label[for='${selectedMode}']`)
        .classList.add("checked");

      // Store the selected mode in localStorage
      localStorage.setItem("mode", selectedMode);
      console.log(
        "Stored mode in localStorage: ",
        localStorage.getItem("mode")
      );

      // Update gradients
      updateGradients(selectedMode);

      // Close the modal
      const modalElement = document.getElementById("colorModal");
      const modalInstance = bootstrap.Modal.getInstance(modalElement);
      modalInstance.hide();
    });
  });

  function updateGradients(color) {
    let planGradient, portfolioGradient;
    switch(color) {
      case 'blue':
        planGradient = 'linear-gradient(140deg, #00E0FF 0%, #301EFF 50%, #AD00FF 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(0,224,255,0.2) 100%)';
        break;
      case 'purple':
        planGradient = 'linear-gradient(140deg, #6100FF 0%, #B200F0 50%, #FF00A8 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(97,0,255,0.2) 100%)';
        break;
      case 'orange':
        planGradient = 'linear-gradient(140deg, #FF0099 0%, #FF5C00 50%, #FFA800 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(255,168,0,0.2) 100%)';
        break;
      case 'green':
        planGradient = 'linear-gradient(140deg, #EBFF00 0%, #00D121 50%, #00FFF0 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(0,209,33,0.2) 100%)';
        break;
      case 'bw':
        planGradient = 'linear-gradient(140deg, #000 0%, #333 50%, #666 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(102,102,102,0.2) 100%)';
        break;
      default: // random
        planGradient = 'linear-gradient(140deg, #665BEA 0%, #AD27DC 50%, #E7854E 100%)';
        portfolioGradient = 'linear-gradient(135deg, #ffffff 0%, rgba(102,91,234,0.2) 100%)';
    }
    planSelector.style.background = planGradient;
    if (portfolioDetailSection) {
      portfolioDetailSection.style.background = portfolioGradient;
    }
  }

  // Remove the button if it exists
  const applyColorButton = document.getElementById("btn_close_color_picker");
  if (applyColorButton) {
    applyColorButton.remove();
  }

  // Initial gradient update
  updateGradients(getMode || 'random');
});




/* HEADER - CALENDLY*/
  document.addEventListener("DOMContentLoaded", function () {
    const config = JSON.stringify({ layout: "month_view" });

    const startProjectButtons = document.querySelectorAll(".start-project");

    startProjectButtons.forEach(function (button) {
      button.setAttribute("data-cal-config", config);
    });
  });

  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", { origin: "https://cal.com" });

  // Cal UI configuration
  Cal("ui", {
    theme: "light",
    styles: {
      branding: {
        brandColor: "#000000",
      },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });





/* HEADER MOBILE MENU */
	jQuery(document).ready(function($) {
	  const navToggler = $(".nav-toggler");
	  const offcanvasNavbar = $("#offcanvas-navbar");
	  const flyoutMenu = $(".flyout_menu");
	  const body = $("body");

	  function openMenu() {
		navToggler.removeClass("not-opened").addClass("opened");
		flyoutMenu.addClass("dragged_in active_menu");
		body.addClass("flyout_opened");
	  }

	  function closeMenu() {
		navToggler.removeClass("opened").addClass("not-opened");
		flyoutMenu.removeClass("dragged_in");
		setTimeout(function() {
		  flyoutMenu.removeClass("active_menu");
		}, 350);
		setTimeout(function() {
		  body.removeClass("flyout_opened");
		}, 500);
	  }

	  navToggler.click(function() {
		if ($(this).hasClass("not-opened")) {
		  openMenu();
		} else {
		  closeMenu();
		}
	  });

	  // Listen for the 'hidden.bs.offcanvas' event
	  offcanvasNavbar.on('hidden.bs.offcanvas', function() {
		closeMenu();
	  });
	});



/* HOME: PICK A PLAN */
  document.addEventListener("DOMContentLoaded", function () {
    const plansPicker = document.querySelector("#plans-picker");
    const dropdownButton = document.getElementById("plan-dropdown");
    const dropdownItems = document.querySelectorAll(
      ".dropdown-menu .dropdown-item"
    );
    const plans = document.querySelectorAll(".chosen-plan > div");

    if (plansPicker) {
      dropdownItems.forEach((item) => {
        item.addEventListener("click", function (event) {
          event.preventDefault();
          const selectedPlan = this.getAttribute("data-plan");

          dropdownButton.textContent = this.textContent;

          plans.forEach((plan) => {
            if (plan.getAttribute("data-id") === selectedPlan) {
              plan.classList.remove("d-none");
            } else {
              plan.classList.add("d-none");
            }
          });
        });
      });
    }
  });




/* HOME: PICK A PLAN: LIST */
  document.addEventListener("DOMContentLoaded", function () {
    const wrappers = document.querySelectorAll(".plan-options-wrapper");

    console.log("Wrappers found:", wrappers);

    wrappers.forEach((wrapper) => {

      wrapper.addEventListener("click", function () {
        
        // Remove the "active" class from all other wrappers
        wrappers.forEach((otherWrapper) => {
          if (otherWrapper !== wrapper) {
            otherWrapper.classList.remove("active");
          }
        });

        wrapper.classList.add("active");
      });
    });
  });









/* PORTFOLIO: SWIPER */
  document.addEventListener("DOMContentLoaded", function () {
    let swiper = new Swiper(".swiper-container", {
      loop: false,
      breakpoints: {
        // when window width is >= 750px
        750: {
          slidesPerView: 2,
		  slidesPerGroup: 2,
        },
        // when window width is < 750px
        0: {
          slidesPerView: 1,
		  slidesPerGroup: 1,
        }
      },
      spaceBetween: 20,
      //autoplay: {
      //  delay: 5000,
      //},
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
    });

    const categoryLinks = document.querySelectorAll("#portfolio-categories a");
    const portfolioCategories = document.querySelectorAll(
      "#portfolio-swiper .portfolio-category"
    );

    // Function to handle category clicks
    function handleCategoryClick(event) {
      event.preventDefault();
      const category = this.getAttribute("data-category");
      console.log("Clicked category:", category);

      // Remove active class from all category links
      categoryLinks.forEach((link) => {
        link.classList.remove("active");
      });

      // Hide all categories and remove active class
      portfolioCategories.forEach((categoryDiv) => {
        categoryDiv.classList.remove("active");
        categoryDiv.classList.add("d-none");
      });

      // Show the selected category and add active class to the clicked link
      const selectedCategory = document.querySelector(
        `#portfolio-swiper .portfolio-category[data-category="${category}"]`
      );
      console.log("Selected category element:", selectedCategory);

      if (selectedCategory) {
        selectedCategory.classList.add("active");
        selectedCategory.classList.remove("d-none");
        this.classList.add("active");

        // Reinitialize Swiper after showing the selected category
        swiper.update();
      } else {
        console.error("No element found for category:", category);
      }
    }

    // Attach click event to all category links
    categoryLinks.forEach((link) => {
      link.addEventListener("click", handleCategoryClick);
    });

    // Show default category and add active class to the default link
    const defaultCategory = document.querySelector(
      "#portfolio-swiper .portfolio-wordpress"
    );

    if (defaultCategory) {
      defaultCategory.classList.add("active");
      defaultCategory.classList.remove("d-none");
      // Find the default link and add the active class
      const defaultLink = document.querySelector(
        '#portfolio-categories a[data-category="wordpress"]'
      );
      if (defaultLink) {
        defaultLink.classList.add("active");
      }
    } else {
      //console.error("No default category element found");
    }

  });




/* FAQ's */
  document.addEventListener("DOMContentLoaded", function () {
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
      const question = item.querySelector(".faq-item-question");

      question.addEventListener("click", function () {

        const isActive = item.classList.contains("active-item");

        faqItems.forEach((i) => {
          i.classList.remove("active-item");
        });

        if (!isActive) {
          item.classList.add("active-item");
        }
      });
    });
  });




