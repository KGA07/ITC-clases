/* global a2a*/
(function (Drupal) {
  'use strict';

  Drupal.behaviors.addToAny = {
    attach: function (context, settings) {
      // If not the full document (it's probably AJAX), and window.a2a exists
      if (context !== document && window.a2a) {
        a2a.init_all(); // Init all uninitiated AddToAny instances
      }
    }
  };

})(Drupal);
;
(function ($, Drupal) {
  Drupal.behaviors.customStaticImage = {
    attach: function (context, settings) {

      var cdnBase = 'https://static.buenosaires.gob.ar';
      cdnBase = cdnBase.replace(/\/$/, '');

      var container = context.querySelectorAll
        ? context
        : document;

      var originalDomain = 'https://buenosaires.gob.ar';

      // =====================
      // IMÁGENES
      // =====================
      container
        .querySelectorAll('.main-content .content img')
        .forEach(function (img) {

          var src = img.getAttribute('src');
          if (!src) return;

          // Caso 1: Ruta relativa
          if (src.startsWith('/sites/default/files')) {
            img.src = cdnBase + src;
            console.log(img.src);
          }

          // Caso 2: URL absoluta con dominio original
          else if (src.startsWith(originalDomain + '/sites/default/files')) {
            img.src = src.replace(originalDomain, cdnBase);
          }

          // Caso 3: Ruta relativa de imágenes del theme
          else if (src.startsWith('/themes/custom/')) {
            img.src = cdnBase + src;
          }

          // Caso 4: URL absoluta con dominio original de imágenes del theme
          else if (src.startsWith(originalDomain + '/themes/custom/')) {
            img.src = src.replace(originalDomain, cdnBase);
          }

        });

      // =====================
      // PDFs (links)
      // =====================
      container
        .querySelectorAll('.main-content .content a[href$=".pdf"]')
        .forEach(function (link) {

          var href = link.getAttribute('href');
          if (!href) return;

          if (href.startsWith('/sites/default/files')) {
            link.href = cdnBase + href;
          }

          else if (href.startsWith(originalDomain + '/sites/default/files')) {
            link.href = href.replace(originalDomain, cdnBase);
          }
        });

      // =====================
      // BOTONES con location.href
      // =====================
      container
        .querySelectorAll('.main-content .content button[onclick]')
        .forEach(function (button) {

          var onclick = button.getAttribute('onclick');
          if (!onclick) return;

          var match = onclick.match(/location\.href\s*=\s*['"]([^'"]+)['"]/);
          if (!match || !match[1]) return;

          var url = match[1];
          var newUrl = null;

          if (url.startsWith('/sites/default/files')) {
            newUrl = cdnBase + url;
          }

          else if (url.startsWith(originalDomain + '/sites/default/files')) {
            newUrl = url.replace(originalDomain, cdnBase);
          }

          if (newUrl) {
            button.setAttribute(
              'onclick',
              "location.href='" + newUrl + "'"
            );
          }
        });

    }
  };
})(jQuery, Drupal);;
(function ($, Drupal) {
  Drupal.behaviors.customSearchRedirect = {
    attach: function (context, settings) {
      $('form[action="/bweb"]', context).once('customSearchRedirect').on('submit', function (e) {
        e.preventDefault(); // Evita el envío del formulario

        // Obtiene el texto ingresado en el buscador
        var searchValue = $(this).find('input[name="keys"]').val();

        if (searchValue) {
          // Codifica el texto para URL y redirige
          var newUrl = '/inicio/resultado-de-busqueda/' + encodeURIComponent(searchValue);
          window.location.href = newUrl;
        }
      });
    }
  };
})(jQuery, Drupal);;
