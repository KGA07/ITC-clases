/**
 * @file gcaba_angular.js
 *
 * Este archivo se encarga de agregar funciones js al modulo angular
 */

(function ($, Drupal, drupalSettings) {

  'use strict';

  Drupal.behaviors.GcabaAngularBehavior = {
    attach: function (context, drupalSettings) {

      var json_urls   = drupalSettings.gcaba_angular.json_urls;
      var url         = drupalSettings.gcaba_angular.url_angular;

      var header      = $('#header');
      var header_link = header.find('a');

      header_link.attr('href', url);
      header_link.attr('target', '_self');

    }
  };


})(jQuery, Drupal);
;
/**
 * @file extras.js
 *
 * Este archivo se encarga de agregar funciones js al modulo extras
 */

(function ($, Drupal, drupalSettings) {

  'use strict';

  Drupal.behaviors.gcabaEvento = {
    attach: function (context, settings) {

      var dateMaxSelector       = $('[data-drupal-selector="edit-field-fecha-del-evento-value-max"]');
      var dateMinSelector       = $('[data-drupal-selector="edit-field-fecha-del-evento-value-min"]');
      var controlDateMaxTRoHide = $('fieldset.js-form-item-field-fecha-del-evento-value-max');

      // Configuración del datepicker
      var datepickerOptions = {
        dateFormat: 'dd-mm-yy'  // Formato: día-mes-año (ej. 25-12-2023)
      };

      if(dateMinSelector.length > 0) {

        dateMinSelector.datepicker(datepickerOptions);
        controlDateMaxTRoHide.css('visibility', 'hidden');
        controlDateMaxTRoHide.css('height', '20px');

        dateMinSelector.on('change', function ()
        {
          var selectedDate = $(this).val();
          var parts = selectedDate.split('-');
          var formattedDate = parts[1] + '-' + parts[0] + '-' + parts[2];
          var selected = new Date(formattedDate);
          selected.setDate(selected.getDate() + 1);
          var nextDay = $.datepicker.formatDate('dd-mm-yy', selected);
          dateMaxSelector.val(nextDay);
        });

        $('#reset-event-filters').click(function(event)
        {
          event.preventDefault();
          event.stopPropagation();
          window.location.reload();
        });

      }

      if ( settings.gcaba_evento.esEventoRecurrente === 'recurrente') {
        $('.title-before-gallery').show();
        $('.title-after-gallery').hide();
      } else if (settings.gcaba_evento.esEventoRecurrente === 'fijo') {
        $('.title-before-gallery').hide();
        $('.title-after-gallery').show();
      }

      $('.node--type-evento').find('.bg-light').removeClass('bg-light');
    }
  };


})(jQuery, Drupal);
;
