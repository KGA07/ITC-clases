# ── Servidor ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Secretos (¡CAMBIAR en producción!) ───────────────────
JWT_SECRET=itc-clases-secret-2026
REFRESH_SECRET=itc-clases-refresh-secret-2026
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ── Almacenamiento ───────────────────────────────────────
# Sin DATABASE_URL se usa db.json local. Con una conexión se usa Postgres
# (tabla kv: bucket, k, value). Se aceptan DATABASE_URL o las variables del
# template de Vercel/Neon (POSTGRES_URL / POSTGRES_URL_NON_POOLING).
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Credenciales iniciales ───────────────────────────────
PROFESOR_USER=GKempe
PROFESOR_PASSWORD=1234
PROFESOR_NOMBRE=Gustavo Kempe
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador

# ── Seguridad login ──────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# ── Enlace al sitio de evaluaciones ──────────────────────
# URL base del proyecto EvaluacionITC para el botón de cruce.
EVALUACIONES_URL=/